<header class='header'>
  <div class='header__inner container'>
    <div class='header__left'>
      <button class='menu-button' type='button' aria-label='Open menu' aria-expanded='false'>
        <span class='menu-button__line'></span>
        <span class='menu-button__line'></span>
        <span class='menu-button__line'></span>
      </button>
      <a class='header__logo' href='/' aria-label='Nuggens home'>
        <svg class='icon icon--logo'>
          <use href='src/assets/icons/sprite.svg#icon-logo'></use>
        </svg>
      </a>
    </div>

    <div class='header__right'>
        <div class="toggle-container">
            <svg class='icon icon--sun'>
                <use href='src/assets/icons/sprite.svg#icon-sun'></use>
            </svg>
            <label class="switch">
                <input class="switch-input" type="checkbox">
                <span class="slider round"></span>
            </label>
            <svg class='icon icon--moon'>
                <use href='src/assets/icons/sprite.svg#icon-moon'></use>
            </svg>
        </div>
            {{> user-bar }}
    </div>
  </div>
</header>