<section class="catalog">
    <h1 class="catalog__title">Product catalog</h1>
    <p class="catalog__text">Browse and manage your food and drinks</p>
    <div class="catalog__buttons">
        {{> button text = "Food" format = 'filled' className='active button__food' size
        = 'medium' }}
        {{> button text = "Drinks" format = 'filled' className='button__drinks'  size
        = 'medium' }}
        {{> button text = "Cheat food" format = 'filled' className='button__cheat-food'  size
        = 'medium' }}
    </div>
    <div class="catalog__pagination">
        <div class="catalog__list">
        </div>
        <button class="pagination__button pagination__button--show-more">
            <svg class="pagination__button-icon">
                <use href='src/assets/icons/sprite.svg#icon-next'></use>
            </svg>
        </button>
    </div>
</section>