<section class='daily-summary' id="summary">
  <header class='daily-summary__header'>
    <h2 class='daily-summary__title'>Daily summary
    </h2>
    <p class='daily-summary__date'>Tuesday, 22 September</p>
  </header>
  <div class='daily-summary__calories'>
    <p class='daily-summary__calories-text'>635
    </p>
    <p class='daily-summary__calories-unit'>kcal</p>
  </div>
  <div class='daily-summary-macros'>
    <div class='daily-summary-macros__macro'>
      <span class='macro__title'>Protein</span>
      <span>35 g</span>
    </div>

    <div class='daily-summary-macros__macro'>
      <span class='macro__title'>Fats</span>
      <span>26 g</span>
    </div>

    <div class='daily-summary-macros__macro'>
      <span class='macro__title'>Carbs</span>
      <span>58 g</span>
    </div>
  </div>
  <footer class='daily-summary__footer'>
    <svg class='daily-summary__footer-svg'>
      <use href='src/assets/icons/sprite.svg#icon-scale'></use>
    </svg>
    <div class='weight-controls'>
      <button class='weight-controls-button controls-button-decrease'>
        <svg class='button-icon'>
          <use href='src/assets/icons/sprite.svg#icon-minus'></use>
        </svg>
      </button>
        <!-- prettier-ignore -->
      <input class='weight-controls-input' type='number' placeholder='Your weight' value='65.2'>
      <button class='weight-controls-button controls-button-increase'>
        <svg class='button-icon'>
          <use href='src/assets/icons/sprite.svg#icon-plus'></use>
        </svg>
      </button>
    </div>
  </footer>
</section>